// Prisma schema — Clothing Store
// See CLAUDE.md for architecture rules. Business logic that touches these
// models lives in src/server/actions; input shapes are validated in
// src/lib/validators before ever reaching a query.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  customer
  admin
}

enum ProductStatus {
  draft
  active
  archived
}

// Only forward transitions (or -> cancelled from pending/processing) are
// valid. Enforce that in the server action, not just here — see CLAUDE.md.
enum OrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
}

// ---------------------------------------------------------------------------
// Users & addresses
// ---------------------------------------------------------------------------

model User {
  id         String   @id @default(cuid())
  // Supabase Auth user id (auth.users.id) this app row corresponds to.
  supabaseId String   @unique
  email      String   @unique
  name       String?
  role       UserRole @default(customer)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  addresses Address[]
  auditLogs AuditLog[]
  cart      Cart?
  orders    Order[]

  @@index([role])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?
  fullName   String
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  country    String
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Collection {
  id          String   @id @default(cuid())
  title       String
  handle      String   @unique
  description String?
  // Optional Arabic overrides for the storefront's ar locale — see
  // Product.titleAr's comment for the full reasoning (same pattern here).
  // Null/empty means "no Arabic override yet"; the storefront falls back
  // to title/description in that case (src/lib/localizedContent.ts).
  titleAr       String?
  descriptionAr String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products ProductCollection[]
}

// Added when the store became a multi-brand marketplace (not just the
// single in-house Leo Fashion line the original plan assumed). Product.brandId
// is deliberately nullable — see the migration note in CLAUDE.md — existing
// products get backfilled by a one-off script rather than a hard schema
// requirement that would break on a database that already has rows.
model Brand {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  description String?
  // Optional Arabic overrides — see Product.titleAr's comment.
  nameAr        String?
  descriptionAr String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  description    String?
  // Optional per-row Arabic overrides for the storefront's ar locale.
  // Catalog content is entered once, in whatever language an admin
  // types it in (see CLAUDE.md's bilingual-storefront phase — this was
  // deliberately out of scope there); these let an admin *additionally*
  // supply a real Arabic title/description for a given row. Deliberately
  // plain nullable columns, not a separate translations table — there
  // are only ever two locales here (see src/i18n/routing.ts), so a join
  // table would just be overhead for what's really "one extra optional
  // field per locale beyond the first." Null or blank means no Arabic
  // override yet; the storefront falls back to title/description in that
  // case (src/lib/localizedContent.ts). The admin dashboard itself always
  // shows/edits the base title/description — it's English/LTR-only and
  // was never in scope for translation.
  titleAr        String?
  descriptionAr  String?
  basePriceCents Int
  status         ProductStatus @default(draft)
  brandId        String?
  brand          Brand?        @relation(fields: [brandId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  variants    ProductVariant[]
  images      ProductImage[]
  collections ProductCollection[]
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([status])
  @@index([brandId])
}

// Added in Phase 2 — Phase 1's schema had no image field, and the product
// detail page needs an ordered gallery. A dedicated table (rather than a
// string array on Product) keeps room for alt text and per-image ordering.
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int      @default(0)
  // Which variant color this photo shows, e.g. "Black" — matches
  // ProductVariant.color exactly (validated against the product's actual
  // variant colors in uploadProductImage/updateProductImageColor, not
  // enforced by the database). Null means a general/all-colors image, the
  // gallery's fallback when nothing color-specific exists for the
  // selected color — see ProductDetail.tsx. Deliberately just a plain
  // string column, not a relation to ProductVariant: an image belongs to
  // a color, not to one specific size+color variant (the same photo of a
  // black t-shirt applies to every size), and a string keeps it robust to
  // colors being added/renamed on variants without a cascading FK to
  // manage.
  color     String?
  createdAt DateTime @default(now())

  @@index([productId])
}

// Explicit join table (not an implicit m:n) so it's easy to extend later
// (e.g. a display "position" within a collection) without a migration that
// changes the relation's shape.
model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId])
}

model ProductVariant {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                String   @unique
  size               String
  color              String
  // Overrides Product.basePriceCents when set (e.g. a size upcharge).
  priceOverrideCents Int?
  inventoryQuantity  Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size, color])
  @@index([productId])
}

// Homepage hero carousel slides, managed by an admin — replaces the earlier
// behavior of auto-generating one slide per Collection (see git history /
// CLAUDE.md for that phase). Deliberately its own model rather than fields
// bolted onto Collection: a banner doesn't have to correspond to a
// collection at all (a sale, an announcement, a brand spotlight), and this
// way a collection can have zero, one, or several banners promoting it
// without forcing a 1:1 relationship. The storefront (src/app/(storefront)
// /page.tsx) falls back to the old collection-derived slides if there are
// no live HeroBanner rows, so the homepage is never left with an empty
// carousel while an admin hasn't set any banners up yet.
model HeroBanner {
  id           String  @id @default(cuid())
  // Always a dedicated hero photo — never reused directly from
  // ProductImage/Collection, since hero banners want a different crop
  // (wide, 16:9–21:9) than product photos. Uploaded via
  // uploadHeroBannerImageFile (src/server/storage.ts), same bucket as
  // product images, different path prefix.
  imageUrl     String
  imageAltText String?
  // Optional — a banner's headline/subtext/CTA are rendered as an HTML
  // overlay (see HeroCarousel) on top of imageUrl. Some banners bake their
  // own stylized text into the image itself (see the seasonal-sale
  // banners) and don't want a second, redundant text layer on top of it,
  // so this isn't required the way it was originally.
  headline String?
  subtext  String?
  // Both optional independently — a banner can be a plain photo + headline
  // with no button, or add a labeled CTA. ctaUrl is where the *whole*
  // slide links to either way (see HeroCarousel), so a banner without a
  // ctaLabel is still clickable; ctaLabel just adds a visible button chip.
  ctaLabel String?
  ctaUrl   String
  // Manual drag-and-drop order in the admin UI — an explicit Int rather
  // than relying on createdAt, so reordering doesn't require faking
  // timestamps. Rewritten in full by reorderHeroBanners whenever the order
  // changes (see src/server/actions/admin/heroBanners.ts).
  position Int @default(0)
  isActive Boolean @default(true)
  // Optional scheduling window — both null means "always live" once
  // active. Date-only inputs from the admin form are converted to
  // start-of-day/end-of-day UTC (src/lib/heroBanners.ts's
  // startOfDayUtc/endOfDayUtc), same pattern DiscountCode.expiresAt uses.
  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
}

// ---------------------------------------------------------------------------
// Cart
// ---------------------------------------------------------------------------

model Cart {
  id     String @id @default(cuid())
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Set for guest (unauthenticated) carts, read from a cookie. Merged into
  // the user's cart on login, then cleared — see Phase 3.
  guestToken String? @unique
  // The code text the customer last successfully applied (see
  // applyDiscountCode), normalized uppercase. Deliberately just a string,
  // not a DiscountCode relation — this is a non-authoritative "what to try
  // at checkout" hint, not a reservation; placeOrder re-validates it fully
  // (active, not expired, redemption limits, min subtotal) inside its
  // transaction before ever touching DiscountCode.redemptionCount, same
  // "never trust client/cart state, re-check server-side" posture as
  // everything else in that action.
  appliedDiscountCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]

  @@index([guestToken])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id])
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id     String      @id @default(cuid())
  userId String
  user   User        @relation(fields: [userId], references: [id])
  status OrderStatus @default(pending)

  // Shipping address is snapshotted inline at checkout time so the order
  // stays accurate even if the customer later edits/deletes the saved
  // Address it was copied from. There's no billing address (no payments),
  // so a single inline set of fields is enough — no separate address table.
  shippingName       String
  shippingLine1      String
  shippingLine2      String?
  shippingCity       String
  shippingState      String?
  shippingPostalCode String
  shippingCountry    String
  shippingPhone      String?

  // Sum of OrderItem.priceCents * quantity at the time the order was placed.
  subtotalCents  Int
  trackingNumber String?

  // Discount, snapshotted at order time — never recomputed from the live
  // DiscountCode later (same historical-record philosophy as OrderItem's
  // titleSnapshot). discountCodeId is kept too (nullable, SetNull) purely
  // for live admin lookups like "how many times has SUMMER20 been used";
  // discountCodeSnapshot/discountPercentSnapshot are what every UI
  // actually displays, so a later edit or deletion of the DiscountCode
  // never changes what a past order shows. Total owed is always computed
  // as subtotalCents - discountCents at display time (see
  // src/lib/cart-totals.ts) — not stored separately, since it's fully
  // derived from data already on this row.
  discountCodeId          String?
  discountCode            DiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  discountCodeSnapshot    String?
  discountPercentSnapshot Int?
  discountCents           Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  // Enforces "one redemption per customer per code" atomically at the DB
  // level — Postgres treats every NULL as distinct in a unique index, so
  // this only ever constrains the (real code, user) pairs, never the many
  // orders with discountCodeId = null. See placeOrder's discount handling
  // in src/server/actions/order.ts for how the resulting P2002 is turned
  // into a friendly error.
  @@unique([discountCodeId, userId])
}

// A store-wide percentage-off promo code. Redemption accounting
// (redemptionCount, and the one-per-customer constraint on Order above)
// only ever advances inside placeOrder's transaction — applying a code to
// a cart (see Cart.appliedDiscountCode) is just a preview and never
// touches this table, so browsing with a code typed in can't burn through
// a limited redemption count or falsely mark it "used" for someone who
// never actually checked out.
model DiscountCode {
  id         String  @id @default(cuid())
  code       String  @unique
  percentOff Int
  isActive   Boolean @default(true)
  // End-of-day (UTC) on the given date is treated as the expiry moment —
  // see src/lib/validators/discount.ts. Null means it never expires.
  expiresAt        DateTime?
  minSubtotalCents Int?
  // Null means unlimited. When set, redemptionCount is only ever advanced
  // via a conditional updateMany (WHERE redemptionCount < maxRedemptions)
  // inside placeOrder's transaction — the same race-safe pattern already
  // used for ProductVariant.inventoryQuantity — so two concurrent
  // checkouts racing for the last redemption slot can't both succeed.
  maxRedemptions  Int?
  redemptionCount Int  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([isActive])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Kept as optional relations (not part of the historical record) so a
  // later product/variant edit or deletion never touches past orders —
  // onDelete: SetNull, not Cascade.
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Snapshot of the product/variant at order time — the historical record.
  titleSnapshot String
  size          String
  color         String
  priceCents    Int
  quantity      Int

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Admin audit trail
// ---------------------------------------------------------------------------

// Simple append-only log of admin mutations — Phase 4. No update/delete
// path is ever exposed for these rows from the app; every admin server
// action that changes a Product/ProductVariant/Order writes one entry here
// alongside its actual mutation, in the same transaction where practical.
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  actor       User     @relation(fields: [actorUserId], references: [id])
  // Dotted action name, e.g. "product.create", "inventory.adjust",
  // "order.status_update".
  action     String
  targetType String
  targetId   String
  // Free-form details specific to the action (e.g. { delta, reason,
  // previousQuantity, newQuantity } for inventory.adjust). Deliberately
  // untyped at the schema level — see src/server/audit.ts for the shapes
  // each action actually writes.
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
}
