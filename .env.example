DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Order notification emails (src/server/email.ts). Sign up at resend.com and
# generate an API key. Leave EMAIL_FROM unset for local dev — it defaults to
# Resend's sandbox address, which only delivers to your own Resend account
# email. Once a sending domain is verified in the Resend dashboard, set
# EMAIL_FROM to something like "Leo Fashion <orders@yourdomain.com>".
RESEND_API_KEY=
EMAIL_FROM=
